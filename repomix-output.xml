          </p>
        </section>

        {/* Footer */}
        <footer className="terms-footer">
          <p>&copy; {new Date().getFullYear()} Tripist Holidays Private Limited. All rights reserved.</p>
        </footer>
      </div>
    </div>
  );
};

export default CancellationRefundPolicy;
