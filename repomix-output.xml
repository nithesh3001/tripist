:root {
  --trip-navy: #0f2d52;
  --trip-gold: #d4af37;
  --trip-gold-bg: rgba(212, 175, 55, 0.12);
  --trip-border: rgba(15, 45, 82, 0.08);
}

/* Base Styles */
.bg-navy { background-color: var(--trip-navy) !important; }
.text-navy { color: var(--trip-navy) !important; }
.text-gold { color: var(--trip-gold) !important; }
.bg-soft-gray { background-color: #f8fafc; }
.tracking-wide { letter-spacing: 1.5px; }

/* Hero */
.about-hero {
  position: relative;
  min-height: 480px;
  background: linear-gradient(110deg, rgba(15, 45, 82, 0.98) 0%, rgba(15, 45, 82, 0.88) 50%, rgba(15, 45, 82, 0.65) 100%),
              radial-gradient(circle at 80% 50%, rgba(212, 175, 55, 0.2), transparent 40%);
}

.hero-eyebrow::before {
  content: "";
  display: inline-block;
  width: 28px;
  height: 2px;
  background: var(--trip-gold);
  margin-right: 8px;
  vertical-align: middle;
}

.btn-hero {
  background-color: rgba(255, 255, 0, 0.719) !important;
  color: var(--trip-navy);
  transition: all 0.25s ease;
}

.btn-hero:hover {
  background-color: #ffffff;
  color: var(--trip-navy);
  transform: translateY(-2px);
}

/* Cards & Icons */
.icon-box-gold {
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--trip-gold);
  background: var(--trip-gold-bg);
  border-radius: 12px;
}

.about-card {
  border: 1px solid var(--trip-border);
  transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
}

.about-card:hover {
  transform: translateY(-3px);
  border-color: rgba(212, 175, 55, 0.4);
  box-shadow: 0 10px 24px rgba(15, 45, 82, 0.08) !important;
}

/* Decorative Background Accents */
.circle-decor {
  position: absolute;
  border: 1px solid rgba(212, 175, 55, 0.15);
  border-radius: 50%;
  pointer-events: none;
}
.circle-hero { width: 380px; height: 380px; right: -120px; top: -120px; }
.circle-lg { width: 420px; height: 420px; right: -140px; top: -140px; }
.circle-sm { width: 240px; height: 240px; left: -80px; bottom: -80px; }
