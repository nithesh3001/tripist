<file path="frontend/src/Components/DomesticRegion.css">
/* ============================================================
   DOMESTIC REGIONS
   ============================================================ */

.domestic-regions {
  width: 100%;
  background: #ffffff;
  padding: 55px 0 75px;
}

.domestic-container {
  width: min(1380px, calc(100% - 80px));
  margin: 0 auto;
}


/* ============================================================
   TOP TABS
   ============================================================ */

.domestic-tabs-wrapper {
  display: flex;
  justify-content: center;
  align-items: center;
}

.domestic-tabs {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 28px;
}

.domestic-tab {
  position: relative;
  border: none;
  background: transparent;
  padding: 4px 0 10px;

  color: #0f2d52;
  font-family: inherit;
  font-size: 20px;
  font-weight: 700;

  cursor: pointer;
  transition: color 0.25s ease;
}

.domestic-tab::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;

  height: 3px;
  border-radius: 10px;

  background: #d4af37;

  transform: scaleX(0);
  transform-origin: center;

  transition: transform 0.25s ease;
}

.domestic-tab:hover {
  color: #d4af37;
}

.domestic-tab.active {
  color: #d4af37;
}

.domestic-tab.active::after {
  transform: scaleX(1);
}


/* ============================================================
   DIVIDER
   ============================================================ */

.domestic-divider {
  width: 100%;
  height: 1px;
  background: #e5e7eb;
  margin: 55px 0 45px;
}


/* ============================================================
   REGION GRID
   ============================================================ */

.region-grid {
  display: grid;

  /*
    Six equal columns on desktop,
    just like the reference image.
  */
  grid-template-columns: repeat(6, minmax(0, 1fr));

  column-gap: 38px;
  align-items: start;
}


/* ============================================================
   REGION CARD
   ============================================================ */

.region-card {
  min-width: 0;
  padding: 0 4px;
}


/* ============================================================
   INDIA MAP
   ============================================================ */

.region-map {
  width: 100%;
  height: 100px;

  display: flex;
  align-items: center;
  justify-content: center;

  margin-bottom: 10px;
}

.region-map img {
  width: 82px;
  height: auto;

  object-fit: contain;

  /*
    Keep the map visually clean.
  */
  display: block;

  transition:
    transform 0.3s ease,
    filter 0.3s ease;
}

.region-card:hover .region-map img {
  transform: translateY(-4px) scale(1.04);
}


/* ============================================================
   REGION TITLE
   ============================================================ */

.region-name {
  margin: 4px 0 18px;

  color: #0f2d52;

  font-size: 17px;
  font-weight: 800;
  line-height: 1.3;

  letter-spacing: 0.1px;
}


/* ============================================================
   STATE LIST
   ============================================================ */

.region-state-list {
  list-style: none;

  margin: 0;
  padding: 0;
}

.region-state-list li {
  margin: 0;
  padding: 0;
}

.region-state-list button {
  display: block;

  width: 100%;

  border: none;
  background: transparent;

  padding: 5px 0;

  text-align: left;

  color: #222;

  font-family: inherit;
  font-size: 14px;
  font-weight: 400;

  line-height: 1.45;

  cursor: pointer;

  transition:
    color 0.2s ease,
    transform 0.2s ease;
}

.region-state-list button:hover {
  color: #d4af37;
  transform: translateX(3px);
}


/* ============================================================
   EMPTY TAB
   ============================================================ */

.domestic-empty-state {
  min-height: 380px;

  display: flex;
  flex-direction: column;

  align-items: center;
  justify-content: center;

  text-align: center;

  padding: 60px 20px;
}

.empty-map {
  margin-bottom: 15px;
}

.empty-map img {
  width: 110px;
  opacity: 0.9;
}

.domestic-empty-state h3 {
  margin: 5px 0 10px;

  color: #0f2d52;

  font-size: 26px;
  font-weight: 800;
}

.domestic-empty-state p {
  max-width: 600px;

  margin: 0;

  color: #667085;

  font-size: 15px;
  line-height: 1.7;
}


/* ============================================================
   LARGE LAPTOP
   ============================================================ */

@media (max-width: 1200px) {

  .domestic-container {
    width: min(1100px, calc(100% - 50px));
  }

  .region-grid {
    column-gap: 25px;
  }

  .region-name {
    font-size: 16px;
  }

  .region-state-list button {
    font-size: 13px;
  }

}


/* ============================================================
   TABLET
   ============================================================ */

@media (max-width: 991px) {

  .domestic-regions {
    padding: 45px 0 60px;
  }

  .domestic-container {
    width: calc(100% - 40px);
  }

  .domestic-tabs {
    gap: 24px;
  }

  .domestic-tab {
    font-size: 18px;
  }

  .domestic-divider {
    margin: 40px 0 35px;
  }

  /*
    3 columns on tablet.
  */
  .region-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    row-gap: 50px;
    column-gap: 35px;
  }

  .region-map {
    height: 90px;
  }

  .region-map img {
    width: 75px;
  }

}


/* ============================================================
   MOBILE
   ============================================================ */

@media (max-width: 767px) {

  .domestic-regions {
    padding: 35px 0 50px;
  }

  .domestic-container {
    width: calc(100% - 30px);
  }

  /*
    Horizontal scrolling tabs prevent them from
    wrapping awkwardly on small screens.
  */
  .domestic-tabs-wrapper {
    width: 100%;
    overflow-x: auto;

    justify-content: flex-start;

    scrollbar-width: none;
  }

  .domestic-tabs-wrapper::-webkit-scrollbar {
    display: none;
  }

  .domestic-tabs {
    width: max-content;
    gap: 25px;
    margin: 0 auto;
  }

  .domestic-tab {
    white-space: nowrap;
    font-size: 16px;
  }

  .domestic-divider {
    margin: 30px 0;
  }

  /*
    Two columns on mobile.
  */
  .region-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));

    column-gap: 25px;
    row-gap: 45px;
  }

  .region-card {
    padding: 0;
  }

  .region-map {
    height: 80px;
    justify-content: flex-start;
  }

  .region-map img {
    width: 70px;
  }

  .region-name {
    margin-bottom: 12px;

    font-size: 16px;
  }

  .region-state-list button {
    padding: 4px 0;
    font-size: 13px;
  }

}


/* ============================================================
   SMALL MOBILE
   ============================================================ */

@media (max-width: 480px) {

  .domestic-container {
    width: calc(100% - 24px);
  }

  .domestic-tabs {
    gap: 20px;
  }

  .domestic-tab {
    font-size: 15px;
  }

  .region-grid {
    column-gap: 20px;
    row-gap: 40px;
  }

  .region-map {
    height: 72px;
  }

  .region-map img {
    width: 62px;
  }

  .region-name {
    font-size: 15px;
  }

  .region-state-list button {
    font-size: 12.5px;
    line-height: 1.4;
  }

}


/* ============================================================
   VERY SMALL DEVICES
   ============================================================ */

@media (max-width: 360px) {

  .region-grid {
    grid-template-columns: 1fr;
    row-gap: 30px;
  }

  .region-card {
    padding-bottom: 15px;

    border-bottom: 1px solid #eeeeee;
  }

  .region-map {
    height: 70px;
  }

}
</file>

