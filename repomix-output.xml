<file path="frontend/src/Components/styles.css">
/* =========================================================
   TRIPIST HERO SLIDER
   Horizontal / Left-to-Right Swiper
   ========================================================= */

/* =========================================================
   COLOR PALETTE
   ========================================================= */

:root {
  --trip-navy: #0f2d52;
  --trip-navy-light: #16406f;

  --trip-gold: #d4af37;
  --trip-gold-hover: #b89628;

  --trip-white: #ffffff;

  --hero-height: 90vh;
}

/* =========================================================
   GLOBAL HERO CONTAINER
   ========================================================= */

.hero-container {
  position: relative;

  width: 100%;
  height: var(--hero-height);

  min-height: 600px;

  overflow: hidden;

  isolation: isolate;
}

/* =========================================================
   SWIPER
   ========================================================= */

.hero-container .mySwiper {
  width: 100%;
  height: 100%;

  overflow: hidden;
}

/*
   IMPORTANT

   Swiper itself controls the transform of:
   
   .swiper-wrapper
   .swiper-slide

   Therefore we DO NOT apply transform/scale
   to .swiper-slide.
*/

.hero-container .swiper-wrapper {
  width: 100%;
  height: 100%;
}

.hero-container .swiper-slide {
  position: relative;

  width: 100%;
  height: 100%;

  overflow: hidden;

  /*
    Do NOT add transform here.
    Swiper controls it automatically.
  */

  box-sizing: border-box;
}

/* =========================================================
   HERO SLIDE
   ========================================================= */

.hero {
  position: relative;

  width: 100%;
  height: 100%;

  overflow: hidden;

  box-sizing: border-box;
}

/* =========================================================
   BACKGROUND
   ========================================================= */

.hero-bg {
  position: absolute;

  top: 0;
  right: 0;
  bottom: 0;
  left: 0;

  width: 100%;
  height: 100%;

  background-position: center center;
  background-size: cover;
  background-repeat: no-repeat;

  transform: scale(1);

  will-change: transform;

  z-index: 0;
}

/* =========================================================
   HERO BACKGROUND IMAGES
   ========================================================= */

.hero1 .hero-bg {
  background-image: url("../assets/hero1.jpg");
}

.hero2 .hero-bg {
  background-image: url("../assets/hero2.jpg");
}

.hero3 .hero-bg {
  background-image: url("../assets/hero3.jpg");
}

.hero4 .hero-bg {
  background-image: url("../assets/hero4.jpg");
}

/* =========================================================
   KEN BURNS EFFECT
   =========================================================

   IMPORTANT:
   Animation is applied ONLY to .hero-bg.

   NEVER apply this to .swiper-slide.
   ========================================================= */

.swiper-slide-active .hero-bg {
  animation: tripistKenBurns 8s ease-out forwards;
}

@keyframes tripistKenBurns {
  0% {
    transform: scale(1);
  }

  100% {
    transform: scale(1.08);
  }
}

/* =========================================================
   DARK IMAGE OVERLAY
   ========================================================= */

.hero-bg-overlay {
  position: absolute;

  top: 0;
  right: 0;
  bottom: 0;
  left: 0;

  width: 100%;
  height: 100%;

  background: linear-gradient(
    180deg,
    rgba(15, 45, 82, 0.72) 0%,
    rgba(15, 45, 82, 0.52) 45%,
    rgba(15, 45, 82, 0.82) 100%
  );

  pointer-events: none;

  z-index: 1;
}

/* =========================================================
   CONTENT OVERLAY
   ========================================================= */

.overlay {
  position: relative;

  z-index: 2;

  width: 100%;
  height: 100%;

  display: flex;

  align-items: center;
  justify-content: center;

  text-align: center;

  padding: 80px 20px;

  box-sizing: border-box;

  pointer-events: none;
}

/*
   Allow buttons to be clicked.
*/

.overlay .hero-content {
  pointer-events: auto;
}

/* =========================================================
   HERO CONTENT
   ========================================================= */

.hero-content {
  width: 100%;

  max-width: 900px;

  margin: 0 auto;

  color: var(--trip-white);

  box-sizing: border-box;
}

/* =========================================================
   BADGE
   ========================================================= */

.hero-badge-pill {
  display: inline-flex;

  align-items: center;
  justify-content: center;

  padding: 7px 20px;

  margin-bottom: 22px;

  border-radius: 50px;

  background: rgba(255, 255, 255, 0.12);

  border: 1px solid rgba(212, 175, 55, 0.45);

  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);

  color: var(--trip-white);

  font-size: 0.85rem;

  font-weight: 600;

  line-height: 1.3;

  text-transform: uppercase;

  letter-spacing: 1px;

  opacity: 0;

  box-sizing: border-box;
}

/* =========================================================
   HERO TITLE
   ========================================================= */

.hero-title {
  margin: 0 0 20px;

  padding: 0;

  font-size: clamp(2.4rem, 5vw, 3.8rem);

  line-height: 1.15;

  font-weight: 800;

  color: var(--trip-white);

  text-shadow: 0 4px 20px rgba(0, 0, 0, 0.45);

  opacity: 0;

  box-sizing: border-box;
}

/* =========================================================
   GOLD TEXT
   ========================================================= */

.text-trip-gold {
  color: var(--trip-gold) !important;
}

/* =========================================================
   HERO DESCRIPTION
   ========================================================= */

.hero-description {
  width: 100%;

  max-width: 750px;

  margin: 0 auto 35px;

  color: rgba(255, 255, 255, 0.92);

  font-size: 1.2rem;

  font-weight: 400;

  line-height: 1.6;

  opacity: 0;

  box-sizing: border-box;
}

/* =========================================================
   HERO BUTTONS
   ========================================================= */

.hero-buttons {
  display: flex;

  align-items: center;
  justify-content: center;

  gap: 18px;

  opacity: 0;

  box-sizing: border-box;
}

/* =========================================================
   PRIMARY BUTTON
   ========================================================= */

.btn-tripist-primary {
  display: inline-flex;

  align-items: center;
  justify-content: center;

  gap: 8px;

  padding: 14px 32px;

  min-height: 50px;

  border-radius: 12px;

  background: var(--trip-gold);

  color: var(--trip-navy);

  font-size: 1rem;

  font-weight: 700;

  line-height: 1;

  text-decoration: none;

  white-space: nowrap;

  box-shadow: 0 6px 20px rgba(212, 175, 55, 0.35);

  transition:
    background-color 0.3s ease,
    color 0.3s ease,
    transform 0.3s ease,
    box-shadow 0.3s ease;
}

.btn-tripist-primary:hover {
  background: var(--trip-gold-hover);

  color: var(--trip-navy);

  transform: translateY(-3px);

  box-shadow: 0 10px 25px rgba(212, 175, 55, 0.5);
}

/* =========================================================
   SECONDARY BUTTON
   ========================================================= */

.btn-tripist-secondary {
  display: inline-flex;

  align-items: center;
  justify-content: center;

  min-height: 50px;

  padding: 14px 32px;

  border-radius: 12px;

  background: rgba(255, 255, 255, 0.12);

  border: 1px solid rgba(255, 255, 255, 0.35);

  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);

  color: var(--trip-white);

  font-size: 1rem;

  font-weight: 600;

  line-height: 1;

  text-decoration: none;

  white-space: nowrap;

  transition:
    background-color 0.3s ease,
    color 0.3s ease,
    transform 0.3s ease;
}

.btn-tripist-secondary:hover {
  background: var(--trip-white);

  color: var(--trip-navy);

  transform: translateY(-3px);
}

/* =========================================================
   TEXT ANIMATIONS
   ========================================================= */

/*
   Only animate elements inside ACTIVE slide.
*/

.swiper-slide-active .hero-badge-pill {
  animation: tripistFadeDown 0.8s ease-out 0.15s forwards;
}

.swiper-slide-active .hero-title {
  animation: tripistFadeUp 0.9s ease-out 0.3s forwards;
}

.swiper-slide-active .hero-description {
  animation: tripistFadeUp 1s ease-out 0.45s forwards;
}

.swiper-slide-active .hero-buttons {
  animation: tripistFadeUp 1s ease-out 0.6s forwards;
}

/* =========================================================
   FADE UP
   ========================================================= */

@keyframes tripistFadeUp {
  from {
    opacity: 0;

    transform: translateY(30px);
  }

  to {
    opacity: 1;

    transform: translateY(0);
  }
}

/* =========================================================
   FADE DOWN
   ========================================================= */

@keyframes tripistFadeDown {
  from {
    opacity: 0;

    transform: translateY(-20px);
  }

  to {
    opacity: 1;

    transform: translateY(0);
  }
}

/* =========================================================
   SWIPER NAVIGATION ARROWS
   ========================================================= */

.mySwiper .swiper-button-prev,
.mySwiper .swiper-button-next {
  width: 52px;
  height: 52px;

  margin-top: -26px;

  border-radius: 50%;

  background: rgba(255, 255, 255, 0.12);

  border: 1px solid rgba(255, 255, 255, 0.15);

  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);

  color: var(--trip-white);

  transition:
    background-color 0.3s ease,
    color 0.3s ease,
    transform 0.3s ease;

  z-index: 10;
}

/* Arrow icons */

.mySwiper .swiper-button-prev::after,
.mySwiper .swiper-button-next::after {
  font-size: 20px;

  font-weight: 700;
}

/* Hover */

.mySwiper .swiper-button-prev:hover,
.mySwiper .swiper-button-next:hover {
  background: var(--trip-gold);

  color: var(--trip-navy);

  transform: scale(1.05);
}

/* =========================================================
   ARROW POSITION
   ========================================================= */

.mySwiper .swiper-button-prev {
  left: 25px;
}

.mySwiper .swiper-button-next {
  right: 25px;
}

/* =========================================================
   PAGINATION
   ========================================================= */

.mySwiper .swiper-pagination {
  position: absolute;

  bottom: 30px !important;

