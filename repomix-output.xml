}

.read-more-btn:hover {
  background: var(--trip-navy);
  color: #fff;
}

/* =========================================================
   FACTS
   ========================================================= */
.destination-facts-section {
  padding: 10px 0 34px;
}

.destination-facts-grid {
  display: grid;
